# DYNIX TRACE local backend configuration (copy to .env to customize)
# The backend binds to loopback only. Do not expose it to a network.

HOST=127.0.0.1
PORT=3001

# Comma-separated list of allowed browser origins for local development.
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# Directory for the local database and AI configuration. Relative paths resolve
# against the server/ directory. Defaults to .data/ next to the server code.
DATA_DIR=.data

# When true, AI provider base URLs may target loopback/private network
# addresses for every provider (trusted local setups only). The Ollama
# provider always allows local addresses; cloud providers are blocked from
# them by default to prevent SSRF against local services.
DYNIX_ALLOW_LOCAL_AI=false
